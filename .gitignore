# HomeLab panel
homelab-panel/config*
homelab-panel/devices*
!homelab-panel/config.example.py
!homelab-panel/devices.example.py

# HomeLab Control
homelab-control/config*
!homelab-control/config.example.json

# Runtime state/logs
homelab-panel/state/
homelab-control/state/
homelab-control/logs/

# Python environment / cache
.venv/
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Shared power scripts under scripts/ are tracked project source.
# Do not add scripts/ to this ignore file.

